# CivicMind AI Environment Configuration

# Application
APP_NAME=CivicMind AI
ENV=development
DEBUG=True
PORT=8000
FRONTEND_URL=http://localhost:5173

# Security & Authentication
SECRET_KEY=civicmind-dev-secret-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite by default for zero-friction local development, PostgreSQL compatible)
DATABASE_URL=sqlite:///./civicmind.db
# For PostgreSQL:
# DATABASE_URL=postgresql://civicmind:civicmind@localhost:5432/civicmind_db

# File Storage
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10

# Machine Learning Models
ML_MODEL_PATH=../ml-training/artifacts/civicmind_mobilenetv3.pt
ML_METADATA_PATH=../ml-training/artifacts/model_metadata.json
CONFIDENCE_THRESHOLD=0.65

# Local LLM & Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# When Ollama is offline or uninstalled, an embedded deterministic RAG response engine will act as the fail-safe provider
LLM_FALLBACK_MODE=true

# RAG & Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
VECTOR_INDEX_PATH=../knowledge-base/processed/faiss_index.bin
CHUNKS_METADATA_PATH=../knowledge-base/processed/chunks_metadata.json
KNOWLEDGE_DOCS_DIR=../knowledge-base/source-documents
SIMILARITY_TOP_K=4
